# Copy to .env for local development. Never put real secrets in this file in Git.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_AUTH_REDIRECT_URL=http://localhost:8080
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Do not place private provider keys here. Any VITE_* value is public in the browser bundle.
# Configure private provider credentials as Supabase Edge Function secrets instead.
